# Files to be ignored by git in a DataFlex workspace

# Libraries are NOT stored in this repo, and this workspace no longer reads
# them from here either - every one of them is a pinned dependency of
# COMManifestStudio.sws and lives in DfPkg\. Libraries\ is kept ignored because
# a maintainer's checkout may still carry one, often as a junction to the shared
# RDC library pool. (Do not git clean -x it.)
/Libraries/

# AppHtml
**/apphtml/global.asa

# AppSrc
**/AppSrc/**/*.prn
**/AppSrc/**/*.dep
**/AppSrc/**/*.dbg
**/AppSrc/**/*.exe.manifest
**/AppSrc/**/*.err
**/AppSrc/**/*.fld
**/AppSrc/**/*.pbg
**/AppSrc/**/*.pdp
**/AppSrc/**/*.pkd
**/AppSrc/**/*.prn
**/AppSrc/**/*.prp
loginEncryptionkey.inc

# Data
**/Data/**/*.log
**/Data/**/*.dat
**/Data/**/*.vld
**/Data/**/*.k*
**/Data/**/*.bad
**/Data/**/*.hdr
**/Data/**/*.cch
**/Data/**/*.cfg
**/Data/**/*.tag
**/Data/**/Deploy/**
**/Data/compileheader.h

# DDSrc
**/DdSrc/**/*.def

# IdeSrc
**/IdeSrc/*.dsk
**/IdeSrc/*.loc
**/IdeSrc/*.mtd

# Programs
**/Programs/*.dbg
**/Programs/*.exe
**/Programs/*.exe.manifest
**/Programs/*.log
**/Programs/*.ini

# Workspace specific
**/Help/**/*.hnd
**/Help/**/Assets
**/Help/**/Online Help
**/HelpText**/*.*

**/DFRefactor_Backup/**

**/Install/**

**/Capture/**

# DataFlex 26 package cache. The Studio's package handler fills DfPkg\ from the
# dependencies listed in COMManifestStudio.sws, pinned by COMManifestStudio.sws.lock.
# Local-only, never committed - it is rebuilt from the lock file on any machine.
/DfPkg/

# Local copies of DataFlex system packages that were retired by renaming.
# The originals are kept on disk on purpose; they are not repository content.
*.shadowed
*.shadowed[0-9]
*.shadowed[0-9][0-9]

# Timestamped manifest snapshots written beside the embedded exe manifest
**/AppSrc/**/*.exe-*.manifest

# Third-party ActiveX controls are licensed separately and are not
# redistributed from this repository.
**/Programs/*.ocx
