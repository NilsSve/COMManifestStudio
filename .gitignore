# Files to be ignored by git in a DataFlex workspace

# Libraries are NOT stored in this repo. setup.bat provides them: on a machine
# with the shared RDC library pool it makes Libraries\ a junction to it (one
# shared, editable copy); otherwise it clones isolated copies inside. Either
# way the folder is local-only, never committed. (Do not git clean -x it.)
/Libraries/

# AppHtml
**/apphtml/global.asa

# AppSrc
**/AppSrc/**/*.prn
**/AppSrc/**/*.dep
**/AppSrc/**/*.dbg
**/AppSrc/**/*.exe.manifest
**/AppSrc/**/*.err
**/AppSrc/**/*.fld
**/AppSrc/**/*.pbg
**/AppSrc/**/*.pdp
**/AppSrc/**/*.pkd
**/AppSrc/**/*.prn
**/AppSrc/**/*.prp
loginEncryptionkey.inc

# Data
**/Data/**/*.log
**/Data/**/*.dat
**/Data/**/*.vld
**/Data/**/*.k*
**/Data/**/*.bad
**/Data/**/*.hdr
**/Data/**/*.cch
**/Data/**/*.cfg
**/Data/**/*.tag
**/Data/**/Deploy/**
**/Data/compileheader.h

# DDSrc
**/DdSrc/**/*.def

# IdeSrc
**/IdeSrc/*.dsk
**/IdeSrc/*.loc
**/IdeSrc/*.mtd

# Programs
**/Programs/*.dbg
**/Programs/*.exe
**/Programs/*.exe.manifest
**/Programs/*.log
**/Programs/*.ini

# Workspace specific
**/Help/**/*.hnd
**/Help/**/Assets
**/Help/**/Online Help
**/HelpText**/*.*

**/DFRefactor_Backup/**

**/Install/**

**/Capture/**

# DataFlex 26 package cache. The Studio's package handler fills DfPkg\ from the
# dependencies listed in COMManifestStudio.sws, the same way setup.bat provides
# Libraries\. Local-only, never committed.
/DfPkg/

# Local copies of DataFlex system packages that were retired by renaming.
# The originals are kept on disk on purpose; they are not repository content.
*.shadowed
*.shadowed[0-9]
*.shadowed[0-9][0-9]

# Timestamped manifest snapshots written beside the embedded exe manifest
**/AppSrc/**/*.exe-*.manifest

# Third-party ActiveX controls are licensed separately and are not
# redistributed from this repository.
**/Programs/*.ocx
