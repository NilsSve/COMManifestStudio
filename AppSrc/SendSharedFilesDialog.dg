// Share new manifest fragment files with the other users of the program: through GitHub, where the global
// Manifest Fragment Library is the ManifestFragmentsLibrary folder of the COMManifestStudio repository.
// GitHub's upload page turns an upload by someone without write access into a pull request, so the author
// checks each file before it reaches the library. E-mail stays as the way for a user without a GitHub account.
// (Until 2026 this sent the files by MAPI e-mail to be added to the SVN repository at VDF-Guidance.)
Use cRDCDbModalPanel.pkg
Use cRDCButton.pkg
Use cManifestIniFile.pkg
Use cLinkLabel.pkg
Use RDCRunProgram.pkg          // RDCOpenUrl
Use vWin32fh.pkg
Use Symdef.pkg

Object oSendSharedFiles_Dialog is a cRDCDbModalPanel
    Set Label to "Share New Manifest Fragment Files"
    Set Size to 151 309
    Set Icon to "FragmentShare.ico"
    Set Border_Style to Border_Dialog

    Object oQuestion_tb is a TextBox
        Set Size to 19 281
        Set Location to 10 15
        Set Auto_Size_State to False
        Set Justification_Mode to JMode_Left
        Set Label to "Press the 'Upload to GitHub' button to share new 'Manifest Fragment Files' you have created with other users of this program."
    End_Object

    Object oInfo_tb is a TextBox
        Set Size to 48 281
        Set Location to 32 15
        Set Auto_Size_State to False
        Set Justification_Mode to JMode_Left
        Set Label to "Two windows open: your local 'Manifest Fragment Library' in Windows Explorer, and GitHub's upload page in your web browser. Drag the new files from Explorer onto the upload page and press the green button at the bottom. GitHub then sends them to the author of this program, who checks them and adds them to the global library. You need a free GitHub account."
    End_Object

    Object oQuestion2_tb is a TextBox
        Set Size to 10 281
        Set Location to 86 15
        Set Auto_Size_State to False
        Set Justification_Mode to JMode_Left
        Set Label to "No GitHub account? Then send the files by e-mail:"
    End_Object

    Object oLink_Label is a cLinkLabel
        Set Size to 8 281
        Set Location to 100 15
        Set Label to ('<A HREF="mailto:' + CS_NewFragmentFileEmail + '?Subject=' + CS_AutoGeneratedHeader + '&body=' + CS_AutoGeneratedBody + '">Send New Manifest Fragment File(s) by e-mail</A>')
        Procedure OnClick Integer iItem String sID String sUrl
            String sName
            // First show Windows Explorer with the local 'Manifest Fragment Library', so user can drag & drop files from there
            // to the e-mail client.
            Send OpenLocalLibrary
            Get Network_User_Name to sName
            Move (sUrl * "Shared by:" * sName) to sUrl
            Runprogram Shell Background sUrl
            Send Close_Panel
        End_Procedure
    End_Object

    Object oOk_btn is a cRDCButton
        Set Size to 14 70
        Set Location to 127 171
        Set Label to "&Upload to GitHub"
        Set psImage to "FragmentShare.ico"
        Set Status_Help to "Open your local Manifest Fragment Library and GitHub's upload page for the global library"
        Set peAnchors to anBottomRight
        Set Default_State to True
        Procedure OnClick
            Send DoShareOnGitHub
        End_Procedure
    End_Object

    Object oClose_btn is a cRDCButton
        Set Size to 14 50
        Set Label    to "Close"
        Set Status_Help to "Close Panel"
        Set Location to 127 246
        Set peAnchors to anBottomRight
        Procedure OnClick
           Send Close_Panel
        End_Procedure
    End_Object

    // Windows Explorer with the local 'Manifest Fragment Library', to drag the files from.
    Procedure OpenLocalLibrary
        String sPath
        Get psManifestFragmentLibrary of ghoManifestFunctionLibrary to sPath
        Send vShellExecute "open" "Explorer.exe" sPath ""
    End_Procedure

    Procedure DoShareOnGitHub
        Send OpenLocalLibrary
        Send RDCOpenUrl CS_GitHubUploadPage
        Send Close_Panel
    End_Procedure

    On_Key Key_Alt+Key_U  Send KeyAction of oOk_btn
    On_Key Key_Alt+Key_C  Send KeyAction of oClose_btn
    On_Key Key_Ctrl+Key_C Send KeyAction of oClose_btn
    On_Key Key_Escape     Send KeyAction of oClose_btn
End_Object
