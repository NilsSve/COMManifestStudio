/* THE THEME (Settings > Theme, 2026-11-14): Light, Dark or Follow Windows, read once as the program starts - here,
   when the ini file can be read and before the windows are built, as the dashboard's FlexTron pages and the command
   bars take the theme as they are made. Follow Windows is settled here, from Windows' own setting for apps
   (AppsUseLightTheme), so that the native windows and the web pages agree. A new choice needs a restart, which the
   Settings dialog offers. Light is the default: it is how the program has always looked. */
Function WindowsAppsUseLightTheme Returns Boolean
    Handle hoRegistry
    Boolean bOpen bLight
    Move True to bLight
    Get Create U_cRegistry to hoRegistry
    Set phRootKey      of hoRegistry to HKEY_CURRENT_USER
    Set pfAccessRights of hoRegistry to KEY_READ
    Get OpenKey of hoRegistry "Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" to bOpen
    If (bOpen) Begin
        If (ValueExists(hoRegistry, "AppsUseLightTheme")) Begin
            Move (ReadDword(hoRegistry, "AppsUseLightTheme") <> 0) to bLight
        End
        Send CloseKey of hoRegistry
    End
    Send Destroy of hoRegistry
    Function_Return bLight
End_Function

// The title bar dark too, in the dark theme: Windows 10 (20H1) and later draw a window's title bar dark when the
// window asks for it (DWMWA_USE_IMMERSIVE_DARK_MODE, 20). Earlier Windows answer with an error and keep it light.
#IFNDEF get_CMS_DwmSetWindowAttribute
    External_Function CMS_DwmSetWindowAttribute "DwmSetWindowAttribute" dwmapi.dll ;
        Handle hWnd ;
        DWord dwAttribute ;
        Pointer pvAttribute ;
        DWord cbAttribute ;
        Returns Integer
#ENDIF

Procedure SeedProgramTheme
    String sTheme
    Boolean bLight
    Get IniFileValue of ghoManifestIniFile (psSectionName(ghoManifestIniFile)) CS_ThemeSetting CS_ThemeLight to sTheme
    Move CI_FTThemeLight to giFTThemeMode
    If (sTheme = CS_ThemeDark) Begin
        Move CI_FTThemeDark to giFTThemeMode
    End
    If (sTheme = CS_ThemeWindows) Begin
        Get WindowsAppsUseLightTheme to bLight
        If (bLight = False) Begin
            Move CI_FTThemeDark to giFTThemeMode
        End
    End
    Send FTThemeLateObjects
End_Procedure
Send SeedProgramTheme

Object oMain is a Panel
    Set Label to (psProduct(ghoApplication) * "- Managing Registration Free COM (OCX/DLL) Components for Isolated Applications")
    Set Location to 5 0
    // 400 units high: the main view's right-hand panels need about 150 to show without scrolling (2026-11-14). A
    // window that was sized before keeps its size - DataFlex restores it (pbPreserveEnvironment).
    Set Size to 400 564
    Set piMinSize to 357 500

    // In the dark theme the title bar is dark too (CMS_DwmSetWindowAttribute) - once the window exists.
    Procedure Page Integer iPageObject
        Integer iDark iVoid
        Forward Send Page iPageObject
        If (giFTThemeMode = CI_FTThemeDark) Begin
            Move 1 to iDark
            Move (CMS_DwmSetWindowAttribute(Window_Handle(Self), 20, AddressOf(iDark), 4)) to iVoid
        End
    End_Procedure
    Set Icon to "COMManifestManager.ico"  

    Object oCJCommandBarSystem is a cRDCCJCommandBarSystem
        Property Integer piDesiredIconSize 16 // The menus' icons
        Set pbLargeIcons to False             // small toolbar icons, as in DataFlex's own programs (Order Entry)
        Set peVisualTheme to (FTCJTheme())    // the theme's: Visual Studio 2022 Light, or 2017 Dark (RDCFlexTron)

        Procedure OnCreateCommandBars
            Forward Send OnCreateCommandBars
            Set pbCenterTabbedViews to False
        End_Procedure

        // The views' tab strip ("Main view"): RDCToolsLib gives it Visual Studio 2010's light colours. The dark
        // theme gives it Visual Studio 2012's dark ones (2026-11-14).
        Procedure OnCreateTabbedWorkspace Handle hoTabWorkspace Handle hoTabPaintManager
            Forward Send OnCreateTabbedWorkspace hoTabWorkspace hoTabPaintManager
            If (giFTThemeMode = CI_FTThemeDark) Begin
                Set ComAppearance of hoTabPaintManager to xtpTabAppearanceVisualStudio2012
                Set ComColor      of hoTabPaintManager to xtpTabColorVisualStudio2012Dark
            End
        End_Procedure

        Procedure DoChangeToolbars
            Variant vPaintManager
            Handle hoPaintManager hoOptions
            Integer iSize iState eTheme
            Boolean bLargeIcons
            String  sState

            Get OptionsObject to hoOptions

            Move (FTCJTheme()) to eTheme
            Send SetTheTheme eTheme
            // How the icons should be shown in toolbars;
            // 1) Icons only.
            // 2) Icons and caption to the right
            // 3) Icons and caption below the icon. Default.
            Get IniFileValue of ghoManifestIniFile (psSectionName(ghoManifestIniFile)) CS_ToolbarIconText CS_ShowIconOnly to sState
            If (sState = CS_ShowTextRightOfIcon) Begin
                Move xtpButtonIconAndCaption to iState
            End
            Else If (sState = CS_ShowTextBelowIcon) Begin
                Move xtpButtonIconAndCaptionBelow to iState
            End
            Else If (sState = CS_ShowIconOnly) Begin
                Move xtpButtonIcon to iState
            End

            Get IniFileValue of ghoManifestIniFile (psSectionName(ghoManifestIniFile)) CS_piToolbarIconSize 32 to iSize
            Move (iSize >= 32) to bLargeIcons
            Set pbShowTextBelowIcons to (iState = xtpButtonIconAndCaptionBelow)
            Send ComSetIconSize      of hoOptions bLargeIcons iSize iSize  // Set icon size for Toolbar buttons.
            Send ComSetPopupIconSize of hoOptions (piDesiredIconSize(Self)) (piDesiredIconSize(Self))
            Set pbLargeIcons         to bLargeIcons

            Get Create (RefClass(cCJPaintManager)) to hoPaintManager
            Get ComPaintManager                    to vPaintManager
            Set pvComObject of hoPaintManager      to vPaintManager
            Set ComThemedCheckBox                  of hoPaintManager to True
            Set ComAutoResizeIcons                 of hoPaintManager to True
            Send ComRefreshMetrics                 of hoPaintManager
            Send Destroy                           of hoPaintManager
        End_Procedure

        Procedure DoChangeToolTipFormat
            Variant vToolTip
            Handle  hoObject
            Integer eTheme iToolTipStyle
            Boolean bIsBalloonStyleSupported

            Get ComToolTipContext to vTooltip
            Get Create (RefClass(cCJToolTipContext)) to hoObject
            Set pvComObject of hoObject to vTooltip
            Move xtpToolTipStandard to iToolTipStyle
            If (iToolTipStyle = -1) Begin
                Get peVisualTheme to eTheme
                Set ComStyle of hoObject to eTheme
            End
            Else Begin
                // Baloon tooltip style requires IE 5.0 or later, so check if installed.
                // The ComShowTitleAndDescription also requires IE 5.0.
                Get ComIsBalloonStyleSupported of hoObject to bIsBalloonStyleSupported
                If (bIsBalloonStyleSupported = False) Begin
                    // If not supported we cannot show baloon tooltip; use standard style instead.
                    If (iToolTipStyle = xtpToolTipBalloon) Begin
                        Move xtpToolTipStandard to iToolTipStyle
                    End
                End
                Set ComStyle of hoObject to iToolTipStyle
                If (bIsBalloonStyleSupported = True) Begin
                    Send ComShowTitleAndDescription of hoObject True xtpToolTipIconInfo
                End
            End
            Set  ComShowOfficeBorder        of hoObject to True
            Set  ComShowShadow              of hoObject to True
            // Set the max width for a tooltip. 250 just seems to be a good
            // compromise. After 250 pixels the text will wrap to the next line.
            Set  ComMaxTipWidth             of hoObject to 250 // In pixels
            Send Destroy of hoObject
            If (phoStatusBar(ghoCommandBars)) Begin
                Send DoChangeToolTipFormat of (phoStatusBar(Self))
            End
        End_Procedure

        Procedure Set piToolbarIconSize Integer iSize
            Handle hoOptions

            If (not(IsComObjectCreated(Self))) Begin
                Procedure_Return
            End

            Get OptionsObject to hoOptions
            Send ComSetIconSize of hoOptions False iSize iSize  // Set icon size for Toolbar buttons.
            Send ComRecalcLayout
        End_Procedure

        Procedure SetTheTheme Integer eTheme
            Integer iColor
            Set peVisualTheme to eTheme
            Send ComRecalcLayout 
            // The views in the toolbar's colour - in the light theme. In the dark theme the main view is a FlexTron
            // page in the theme's own colours, and the native colour is left alone.
            If (giFTThemeMode = CI_FTThemeLight) Begin
                Get ComGetSpecialColor XPCOLOR_TOOLBAR_FACE to iColor
                Broadcast Recursive Set Color of (Client_Id(phoMainPanel(ghoApplication))) to iColor
            End
        End_Procedure

        /* THE MENU BAR AND THE TOOLBARS (2026-11-14), the way DataFlex's own programs have them - the Order Entry
           example's: a File menu of the standard data entry items, Navigate and Help, and the Finding, Data Entry and
           Edit toolbars, all of DataFlex's standard classes, with their own captions, icons and shortcuts. This
           program's own functions are its own menus - Manifest, Fragments, Components and Tools - and the main
           view's dashboard has labelled buttons for the steps of making a manifest. Until then the program had seven
           toolbars of icons, and a user of many years still hovered over them to tell them apart.

           Alt plus a letter opens a menu, so the two Alt shortcuts that used one of the menus' letters are gone:
           Configure (Alt+F) and Create (Alt+R). So is Compress's Ctrl+Z, which every edit field uses for Undo. The
           other shortcuts are kept; the keys themselves are the On_Key lines at the end of the main view. */
        Object oMenuBar is a cCJMenuBar

            Object oFile_Menu is a cCJMenuItem
                Set peControlType to xtpControlPopup
                Set psCaption to "&File"
                Set psDescription to "Open, find, save, delete or clear manifests, or quit this application."

                Object oNewProject_MenuItem is a cCJMenuItem
                    Set psCaption to "&New Project..."
                    Set psDescription to "A wizard that makes a manifest file for a Windows program (.exe)"
                    Set psImage to "ProjectNew.ico"
                    Set psShortcut to "Ctrl+N"

                    Procedure OnExecute Variant vCommandBarControl
                        Send DoStartWizard of (Client_Id(ghoCommandBars))
                    End_Procedure
                End_Object

                Object oOpenManifest_MenuItem is a cCJMenuItem
                    Set psCaption to "Se&lect Manifest..."
                    Set psDescription to "Choose one of the manifests this program keeps"
                    Set psImage to "ActionPrompt.ico"
                    Set psShortcut to "Alt+O, F4"

                    Procedure OnExecute Variant vCommandBarControl
                        Send DoShowMainPromptList of (Client_Id(ghoCommandBars))
                    End_Procedure
                End_Object

                Object oBrowseManifest_MenuItem is a cCJMenuItem
                    Set psCaption to "&Browse for Manifest File..."
                    Set psDescription to "Browse for an application manifest file. It has the same name as the program, with '.manifest' added. The COM components it lists already are looked up in your fragment library."
                    Set psImage to "FolderOpen.ico"
                    Set psShortcut to "Ctrl+O"

                    Procedure OnExecute Variant vCommandBarControl
                        Send DoBrowseManifestFile of (phoMainView(ghoApplication))
                    End_Procedure
                End_Object

                Object oClearMenuItem is a cCJClearMenuItem
                    Set pbControlBeginGroup to True
                End_Object

                Object oClearAllMenu is a cCJClearAllMenuItem
                End_Object

                Object oPromptMenuItem is a cCJPromptMenuItem
                    Set pbControlBeginGroup to True
                End_Object

                Object oFindMenuItem is a cCJFindMenuItem
                    Set pbControlBeginGroup to True
                End_Object

                Object oFindNextMenu is a cCJFindNextMenuItem
                End_Object

                Object oFindPreviousMenu is a cCJFindPreviousMenuItem
                End_Object

                Object oFindFirstMenu is a cCJFindFirstMenuItem
                End_Object

                Object oFindLastMenu is a cCJFindLastMenuItem
                End_Object

                Object oSaveMenuItem is a cCJSaveMenuItem
                    Set pbControlBeginGroup to True
                End_Object

                Object oDeleteMenuItem is a cCJDeleteMenuItem
                End_Object

                Object oExitMenu is a cCJExitMenuItem
                    Set pbControlBeginGroup to True
                End_Object
            End_Object

            Object oManifest_Menu is a cCJMenuItem
                Set peControlType to xtpControlPopup
                Set psCaption to "&Manifest"
                Set psDescription to "Build and deploy the manifest that is open"

                Object oBuild_MenuItem is a cCJMenuItem
                    Set psCaption to "&Build manifest"
                    Set psDescription to "Builds the application manifest file: checks for duplicate type libraries, then merges the fragment files into the manifest file"
                    Set psImage to "Build.ico"
                    Set psShortcut to "Alt+B"
                    Set pbControlBeginGroup to True

                    Procedure OnExecute Variant vCommandBarControl
                        String sFileName
                        String[] sFilesArray
                        Forward Send OnExecute vCommandBarControl
                        Get psManifestFileName of ghoManifestFunctionLibrary    to sFileName
                        Get SelectedItems of (phoManifest_grid(ghoApplication)) to sFilesArray
                        Send BuildManifestFile of ghoManifestFunctionLibrary sFileName sFilesArray
                        Send RefreshDashboard of ghoApplication
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        String sManifestFile
                        Integer iItems
                        Get ItemCount of (phoManifest_grid(ghoApplication)) to iItems
                        Get psManifestFileName of ghoManifestFunctionLibrary to sManifestFile
                        Function_Return (sManifestFile <> "" and iItems > 0)
                    End_Function
                End_Object

                Object oEditApplicationManifest_MenuItem is a cCJMenuItem
                    Set psCaption to "&View or edit the manifest file"
                    Set psDescription to "Opens the application manifest file in the editor"
                    Set psImage to "EditDocument.ico"
                    Set psShortcut to "Alt+E"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        Send EditAppManifestFile of ghoManifestFunctionLibrary
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        String sManifestFile
                        Get psManifestFileName of ghoManifestFunctionLibrary to sManifestFile
                        Function_Return (sManifestFile <> "")
                    End_Function
                End_Object

                Object oCopyComponents_MenuItem is a cCJMenuItem
                    Set psCaption to "&Check and copy COM files..."
                    Set psDescription to "Checks that the COM (OCX/DLL) components are in the program's folder, and copies the ones that are missing"
                    Set psImage to "CopyFiles.ico"
                    Set psShortcut to "Ctrl+P"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        String[] sSelectedFileNames
                        Forward Send OnExecute vCommandBarControl
                        Get SelectedItems of (phoManifest_grid(ghoApplication)) to sSelectedFileNames
                        Send CopyCOMComponents of ghoManifestFunctionLibrary sSelectedFileNames
                        Send RefreshDashboard of ghoApplication
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        String sManifestFile
                        Get psManifestFileName of ghoManifestFunctionLibrary to sManifestFile
                        Function_Return (sManifestFile <> "")
                    End_Function
                End_Object

                Object oEmbedApplicationManifest_MenuItem is a cCJMenuItem
                    Set psCaption to "&Embed in the program"
                    Set psDescription to "Embeds the manifest file in the program (.exe) file"
                    Set psImage to "EmbedCode.ico"
                    Set psShortcut to "Ctrl+E"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send EmbedManifestInProgram of ghoManifestFunctionLibrary
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        String sManifestFile
                        Get psManifestFileName of ghoManifestFunctionLibrary to sManifestFile
                        Function_Return (sManifestFile <> "")
                    End_Function
                End_Object

                Object oCompressApplication_MenuItem is a cCJMenuItem
                    Set psCaption to "Co&mpress the program"
                    Set psDescription to "Compresses the program (.exe) file. It often makes the file about 80% smaller."
                    Set psImage to "Compress.ico"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send CompressExeFile of ghoManifestFunctionLibrary
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        String sManifestFile
                        Get psManifestFileName of ghoManifestFunctionLibrary to sManifestFile
                        Function_Return (sManifestFile <> "")
                    End_Function
                End_Object

                Object oRunProgram_MenuItem is a cCJMenuItem
                    Set psCaption to "&Run the program"
                    Set psDescription to "Starts the program, to check that its manifest file is right"
                    Set psImage to "RunProgram.ico"
                    Set psShortcut to "Ctrl+R"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        String sPath sProgramName
                        Forward Send OnExecute vCommandBarControl
                        Get psExeFilePath of ghoManifestFunctionLibrary to sPath
                        Get psExeFileName of ghoManifestFunctionLibrary to sProgramName
                        // Runprogram background can in some rare occations result in a crash.
                        // That never happens with shellexecute...
                        Send vShellExecute "open" sProgramName "" sPath
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        String sProgramName
                        Get psExeFileName of ghoManifestFunctionLibrary to sProgramName
                        Function_Return (sProgramName <> "")
                    End_Function
                End_Object
            End_Object

            Object oFragments_Menu is a cCJMenuItem
                Set peControlType to xtpControlPopup
                Set psCaption to "F&ragments"
                Set psDescription to "The manifest fragment files: one for each COM (OCX/DLL) component"

                Object oAddFragments_MenuItem is a cCJMenuItem
                    Set psCaption to "&Add fragment files..."
                    Set psDescription to "Choose fragment files from your library for the manifest that is open"
                    Set psImage to "ActionPrompt.ico"

                    Procedure OnExecute Variant vCommandBarControl
                        Send DoAddFragmentFiles of (phoMainView(ghoApplication))
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (ManHdr.ID <> 0)
                    End_Function
                End_Object

                Object oFragmentEdit_MenuItem is a cCJMenuItem
                    Set psCaption to "&Edit fragment file"
                    Set psDescription to "Opens the fragment file under the cursor in the list in the editor"
                    Set psImage to "FragmentEdit.ico"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send OpenCurrentGridItem of ghoManifestFunctionLibrary
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (ManDet.ID <> 0)
                    End_Function
                End_Object

                Object oFragmentNew_MenuItem is a cCJMenuItem
                    Set psCaption to "&Create a fragment file..."
                    Set psDescription to "Create a new manifest fragment file for a COM (OCX/DLL) component that has none - in your library, or on GitHub ('Get new files from GitHub')"
                    Set psImage to "FragmentNew.ico"
                    Set pbControlBeginGroup to True

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send Popup of (oCreateManifestFragmentFile(Client_Id(ghoCommandBars)))
                        Send RefreshDashboard of ghoApplication
                    End_Procedure
                End_Object

                Object oFragmentsForFolder_MenuItem is a cCJMenuItem
                    Set psCaption to "Create for a &whole folder..."
                    Set psDescription to "Create fragment files for all the COM (OCX) components in a folder, in one go - for a new Codejock release, say"
                    Set psImage to "FolderOpen.ico"

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send Activate_oCreateFragmentFilesFromFolder of (Client_Id(ghoCommandBars)) ""
                        Send RefreshDashboard of ghoApplication
                    End_Procedure
                End_Object

                Object oFragmentDownload_MenuItem is a cCJMenuItem
                    Set psCaption to "&Get new files from GitHub..."
                    Set psDescription to "Checks the global 'Manifest Fragment Library' on GitHub for files that are new to your library, or that differ from your copy, and lets you choose which to download"
                    Set psImage to "FragmentDownload.ico"
                    Set psShortcut to "Alt+D"
                    Set pbControlBeginGroup to True

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send DownloadManifestFragmentFiles of ghoManifestFunctionLibrary
                        Send RefreshDashboard of ghoApplication
                    End_Procedure
                End_Object

                Object oFragmentShare_MenuItem is a cCJMenuItem
                    Set psCaption to "&Share your files on GitHub..."
                    Set psDescription to "Upload fragment files you made to the global 'Manifest Fragment Library' on GitHub, where they are checked before they are added"
                    Set psImage to "FragmentShare.ico"
                    Set psShortcut to "Alt+S"

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send DoShareManifestFragmentFiles of (Client_Id(ghoCommandBars))
                    End_Procedure
                End_Object
            End_Object

            Object oComponents_Menu is a cCJMenuItem
                Set peControlType to xtpControlPopup
                Set psCaption to "&Components"
                Set psDescription to "The COM (OCX/DLL) component of the fragment file under the cursor in the list"

                Object oIsComponentRegistered_MenuItem is a cCJMenuItem
                    Set psCaption to "&Check registration"
                    Set psDescription to "Is the COM (OCX/DLL) component of the fragment file under the cursor registered with Windows?"
                    Set psImage to "COMCheck.ico"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        String sManifestFragmentFile sResult sCOMFileName
                        Boolean bRegistered
                        Forward Send OnExecute vCommandBarControl
                        Move (Trim(ManDet.ManifestFragmentFile)) to sManifestFragmentFile
                        Get CheckCOMRegistrationFromManifestFragmentFile of ghoManifestFunctionLibrary sManifestFragmentFile to bRegistered
                        Get ExtractCOMFileName of ghoManifestFunctionLibrary sManifestFragmentFile to sCOMFileName
                        If (bRegistered = True) Begin
                            Move ("Yes, the" * sCOMFileName * "component is registered with Windows.") to sResult
                        End
                        Else Begin
                            Move ("No, the" * sCOMFileName * "component is not registered with Windows.") to sResult
                        End
                        Send Info_Box sResult
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (ManDet.ID <> 0)
                    End_Function
                End_Object

                Object oRegisterComponent_MenuItem is a cCJMenuItem
                    Set psCaption to "&Register"
                    Set psDescription to "Registers the COM (OCX/DLL) component of the fragment file under the cursor with Windows"
                    Set psImage to "RegisterDLL.ico"
                    Set psShortcut to "Alt+L"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send RegisterOrUnregister of ghoManifestFunctionLibrary True
                        Send RefreshDashboard of ghoApplication
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (ManDet.ID <> 0)
                    End_Function
                End_Object

                Object oUnRegisterComponent_MenuItem is a cCJMenuItem
                    Set psCaption to "&Unregister"
                    Set psDescription to "Unregisters the COM (OCX/DLL) component of the fragment file under the cursor from Windows"
                    Set psImage to "UnRegisterDLL.ico"
                    Set pbActiveUpdate to True

                    Procedure OnExecute Variant vCommandBarControl
                        Forward Send OnExecute vCommandBarControl
                        Send RegisterOrUnregister of ghoManifestFunctionLibrary False
                        Send RefreshDashboard of ghoApplication
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (ManDet.ID <> 0)
                    End_Function
                End_Object
            End_Object

