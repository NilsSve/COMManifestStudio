// The wide functions. COMManifestStudio is a DataFlex 26 program, where a string is UTF-8: the ANSI functions above
// took the bytes of a path as ANSI ones and gave ANSI bytes back, and the OemToAnsi, AnsiToOem and Utf8ToAnsi steps
// around them belong to DataFlex 19 and earlier. A path, a running program or a temp folder with a national letter in
// it (C:\Users\Björn\AppData\Local\Temp) was not found or came back garbled, and console text lost its national
// letters. These take and give WStrings - every character as it is. Names of their own; the ANSI ones keep theirs.
#IFNDEF get_CMS_CreateFileW
    External_Function CMS_CreateFileW "CreateFileW" kernel32.dll ;
        Pointer lpFileName ;
        DWord   dwDesiredAccess ;
        DWord   dwShareMode ;
        Pointer lpSecurityAttributes ;
        DWord   dwCreationDisposition ;
        DWord   dwFlagsAndAttributes ;
        Handle  hTemplateFile ;
        Returns Handle
#ENDIF

#IFNDEF get_CMS_GetModuleFileNameExW
    External_Function CMS_GetModuleFileNameExW "GetModuleFileNameExW" psapi.dll ;
        Handle  hProcess ;
        Handle  hModule ;
        Pointer lpFilename ;
        Integer nSize ;
        Returns Integer
#ENDIF

#IFNDEF get_CMS_GetTempPathW
    External_Function CMS_GetTempPathW "GetTempPathW" kernel32.dll ;
        DWord   nBufferLength ;
        Pointer lpBuffer ;
        Returns DWord
#ENDIF

#IFNDEF get_CMS_GetShortPathNameW
    External_Function CMS_GetShortPathNameW "GetShortPathNameW" kernel32.dll ;
        Pointer lpszLongPath ;
        Pointer lpszShortPath ;
        DWord   cchBuffer ;
        Returns DWord
#ENDIF

#IFNDEF get_CMS_WriteConsoleW
    External_Function CMS_WriteConsoleW "WriteConsoleW" kernel32.dll ;
        Handle  hConsoleOutput ;
        Pointer lpBuffer ;
        DWord   nNumberOfCharsToWrite ;
        Pointer lpNumberOfCharsWritten ;
        Pointer lpReserved ;
        Returns Integer
#ENDIF

// The length of a WString in UTF-16 characters, as WriteConsoleW counts them.
#IFNDEF get_CMS_lstrlenW
    External_Function CMS_lstrlenW "lstrlenW" kernel32.dll ;
        Pointer lpString ;
        Returns Integer
#ENDIF

