Use Windows.pkg
Use cTextEdit.pkg
Use cRDCButton.pkg
Use cRDCModalPanel.pkg
Use cRDCForm.pkg
Use cManifestFunctionLibrary.pkg
Use vWin32fh.pkg
Use CreateFragmentFilesFromFolder.dg

Object oCreateManifestFragmentFile is a cRDCModalPanel
    Set Size to 155 480
    Set Label to "Create New Manifest Fragment File"
    Set Icon to "FragmentNew032N32.ico"
    Set Sysmenu_Icon to False
    Set Maximize_Icon to False
    Set Minimize_Icon to False

    // The description Browse... put in oFragmentDescription_fm. Left as it is, Create! passes "" instead, and
    // the library makes the suggestion again as it writes the file - fuller by then, when the component was
    // registered in between (the type library's name comes from the registration).
    Property String psSuggestedDescription ""

    Object oCOMComponentFileName_fm is a cRDCForm
        Set Size to 13 333
        Set Location to 68 81
        Set Label to "COM Component File"
        Set Enabled_State to False
        Set peAnchors to anTopLeftRight
        Procedure OnChange
            String sValue
            Boolean bState
            Get Value to sValue
            Move (sValue <> "") to bState
            Set Enabled_State of oCheck_btn      to bState
            Set Enabled_State of oRegister_btn   to bState
            Set Enabled_State of oUnRegister_btn to bState
            Set Enabled_State of oCreate_btn     to bState
        End_Procedure
    End_Object

    Object oSelect_btn is a cRDCButton
        Set Location to 68 419
        Set Label to "Browse..."
        Set psImage to "FolderOpen.ico"
        Set peAnchors to anTopRight

        Procedure OnClick
            String sValue sPath sCOMFile sDefaultFile sDescription

            Get Value of oCOMComponentPath_fm to sPath
            If (sPath = "") Begin
                Get psCommonCOMLibrary of ghoManifestFunctionLibrary to sPath
            End
            Get vFolderFormat of ghoManifestFunctionLibrary sPath to sPath

            Get vSelect_File "*.ocx and *.dll files|*.ocx;*.dll" "Select a COM (OCX/DLL) component" sPath to sValue
            Get ParseFileName sValue to sCOMFile
            If (sCOMFile <> "") Begin
                Get ParseFolderName sValue to sPath
                Set Value of oCOMComponentFileName_fm  0 to sCOMFile
                Set Value of oCOMComponentPath_fm      0 to sPath 
                // Prefill editable fragment filename, keeping the physical COM name unchanged.
                Get ManifestFragmentFileName of ghoManifestFunctionLibrary sCOMFile to sDefaultFile
                Set Value of oFragmentFileName_fm 0 to sDefaultFile

                // The description the file would get on its first line (the type library's name, the build and
                // the version). The field remains editable, e.g. to correct DR26's 25.2 label.
                Send Cursor_Wait of Cursor_Control
                Get SuggestedFragmentDescription of ghoManifestFunctionLibrary sPath sCOMFile to sDescription
                Send Cursor_Ready of Cursor_Control
                Set psSuggestedDescription to sDescription
                Set Value of oFragmentDescription_fm 0 to sDescription
            End
        End_Procedure

    End_Object

    Object oCOMComponentPath_fm is a cRDCForm
        Set Size to 13 333
        Set Location to 83 81
        Set Label to "Path"
        Set Enabled_State to False
        Set peAnchors to anTopLeftRight
    End_Object

    Object oFolder_btn is a cRDCButton
        Set Location to 83 419
        Set Label to "Folder..."
        Set psImage to "FolderOpen.ico"
        Set Status_Help to "Create fragment files for all the COM (OCX) components in a folder, in one batch"
        Set peAnchors to anTopRight

        Procedure OnClick
            String sPath

            // Start in the folder of the component above, if one was selected.
            Get Value of oCOMComponentPath_fm to sPath
            Send Activate_oCreateFragmentFilesFromFolder sPath
        End_Procedure

    End_Object

    // Editable defaults populated when a COM component is selected.
    Object oFragmentFileName_fm is a cRDCForm
        Set Size to 13 333
        Set Location to 100 81
        Set Label to "Fragment Filename"
        Set peAnchors to anTopLeftRight
        Set Status_Help to "Suggested .txt filename; edit as needed. Blank uses the COM component filename."
    End_Object

    Object oFragmentDescription_fm is a cRDCForm
        Set Size to 13 333
        Set Location to 115 81
        Set Label to "Description"
        Set peAnchors to anTopLeftRight
        Set Status_Help to "Suggested first-line comment; edit as needed. Blank uses the generated description."
    End_Object

    Object oCreate_btn is a cRDCButton
        Set Label to "&Create!"
        Set Location to 115 419
        Set psImage to "CopyComponents.ico"
        Set Enabled_State to False
        Set Status_Help to "Create a manifest fragment file for the selected COM (OCX/DLL) component."
        Set peAnchors to anTopRight

        Procedure OnClick
            String sPath sCOMComponentFileName sFileName sEditor sEditorParams sText sNote
            String sCustomFileName sCustomDescription
            Integer iRetval
            Boolean bRegistered bOk

            Get Value of oCOMComponentPath_fm     to sPath
            Get Value of oCOMComponentFileName_fm to sCOMComponentFileName
            If (sPath = "" or sCOMComponentFileName = "") Begin
                Send Info_Box "You need to select a component (.ocx or .dll file) first."
                Procedure_Return
            End

            Get CheckIfCOMComponentIsRegistered of ghoManifestFunctionLibrary sPath sCOMComponentFileName to bRegistered

            If (bRegistered = False) Begin
                Move ("The" * sCOMComponentFileName * "component is not registered with Windows. Do you want to register it?") to sText
                Move "\n\nNote: If you click the 'Yes' button and UAC - User Access Control - is active on the machine, you will be presented with a Windows dialog with the question: 'Do you want to allow the following program to make changes to this computer?'. Select Yes to make the changes." to sNote
                Get YesNo_Box (sText + sNote) to iRetval
                If (iRetval = MBR_No) Begin
                    Procedure_Return
                End
                Else Begin
                    Get RunRegSvrProgram of ghoManifestFunctionLibrary sPath sCOMComponentFileName True to bOK
                    // We need to wait for the RegSvr32 program to finish before we continue.
                    Sleep 6
                End
            End

            Get Value of oFragmentFileName_fm to sCustomFileName
            Get Value of oFragmentDescription_fm to sCustomDescription
            // Left as suggested: "" lets the library make the suggestion again (see psSuggestedDescription).
            If (Trim(sCustomDescription) = Trim(psSuggestedDescription(Self))) Begin
                Move "" to sCustomDescription
            End
            Move (Trim(sCustomFileName)) to sCustomFileName
            // Only a filename, not a path. Avoid accidental writes outside the library.
            If (sCustomFileName <> "") Begin
                If (Pos("\", sCustomFileName) > 0 or Pos("/", sCustomFileName) > 0 or Pos(":", sCustomFileName) > 0) Begin
                    Send Info_Box "Enter a fragment filename only, without a folder path."
                    Procedure_Return
                End
                // Nor a character Windows does not allow in a file name.
                If (Pos("*", sCustomFileName) > 0 or Pos("?", sCustomFileName) > 0 or Pos('"', sCustomFileName) > 0 or Pos("<", sCustomFileName) > 0 or Pos(">", sCustomFileName) > 0 or Pos("|", sCustomFileName) > 0) Begin
                    Send Info_Box 'A fragment filename cannot contain any of the characters * ? " < > |'
                    Procedure_Return
                End
                If (Lowercase(Right(sCustomFileName, 4)) <> ".txt") Begin
                    Move (sCustomFileName + ".txt") to sCustomFileName
                End
            End
            Get CreateManifestFragmentFile of ghoManifestFunctionLibrary sPath sCOMComponentFileName sCustomFileName sCustomDescription to sFileName
            Get vFilePathExists sFileName to iRetval
            Send Cursor_Ready of Cursor_Control
            // If the new manifest fragment file was created successfully, open it in the editor.
            If (iRetval = True) Begin
                Get psManifestFragmentLibrary of ghoManifestFunctionLibrary to sPath
                Get vFolderFormat sPath to sPath
                Get psFileEditor of ghoManifestIniFile to sEditor
                Get psFileEditorParams of ghoManifestIniFile to sEditorParams
                If (sEditorParams <> "") Begin
                    Runprogram Background sEditor ('"' + sEditorParams + '"' * '"' + sFileName + '"')
                End
                Else Begin
                    Runprogram Background sEditor ('"' + sFileName + '"')
                End
                Move "The new manifest fragment file was created successfully and loaded in the editor. You can add an internet link to where the component can be found.\n" to sText
                Move (sText + "Each comment line must begin with two forward slashes.\n\n") to sText
                Move (sText + "Note: If the new file seems incomplete, it might be because the COM (OCX/DLL) component wasn't properly registered with Windows.") to sText
                Send Info_Box sText
            End
            Else Begin
                Send Info_Box "The manifest fragment file could not be created"
            End
        End_Procedure

    End_Object

    Object oCancel_Btn is a cRDCButton
        Set Label to "Close"
        Set Status_Help to "Close Panel"
        Set Location to 135 419
        Set peAnchors to anTopRight

        Procedure OnClick
            Send Close_Panel
        End_Procedure

    End_Object

    Object oCheck_btn is a cRDCButton
        Set Size to 14 56
        Set Label to "Registered?"
        Set Location to 135 81
        Set psImage to "COMCheck.ico"
        Set Enabled_State to False
        Set peAnchors to anNone
        Set Status_Help to "Check if the selected COM (OCX/DLL) component is registered with Windows"

        Procedure OnClick
            String sPath sCOMComponentFileName sResult
            Boolean bRegistered

            Get Value of oCOMComponentPath_fm to sPath
            Get Value of oCOMComponentFileName_fm to sCOMComponentFileName
            If (sPath = "" or sCOMComponentFileName = "") Begin
                Send Info_Box "You need to select a COM component (.ocx or .dll file) first."
                Procedure_Return
            End
            Get vFolderFormat of ghoManifestFunctionLibrary sPath to sPath

            Get CheckIfCOMComponentIsRegistered of ghoManifestFunctionLibrary sPath sCOMComponentFileName to bRegistered

            If (bRegistered = True) Begin
                Move ("Yes, the" * sCOMComponentFileName * "component is registered with Windows registry.") to sResult
            End
            Else Begin
                Move ("No, the" * sCOMComponentFileName * "component is not registered with Windows registry.") to sResult
            End
            Send Info_Box sResult
        End_Procedure

    End_Object

    Object oRegister_btn is a cRDCButton
        Set Label to "Register!"
        Set Location to 135 141
        Set Enabled_State to False
        Set psImage to "RegisterDLL.ico"
        Set Status_Help to "Register the selected COM (OCX/DLL) component in Windows registry."
        Set peAnchors to anNone

        Procedure OnClick
            String sPath sCOMComponentFileName sText sNote
            Boolean bOK bRegistered
            Integer iRetval

            Get Value of oCOMComponentPath_fm to sPath
            Get Value of oCOMComponentFileName_fm to sCOMComponentFileName
            If (sPath = "" or sCOMComponentFileName = "") Begin
                Send Info_Box "You need to select a COM component (.ocx or .dll file) first."
                Procedure_Return
            End
            Get vFolderFormat of ghoManifestFunctionLibrary sPath to sPath

            Get CheckIfCOMComponentIsRegistered of ghoManifestFunctionLibrary sPath sCOMComponentFileName to bRegistered

            If (bRegistered = True) Begin
                Send Info_Box ("The" * sCOMComponentFileName * "component is already registered with Windows.")
                Procedure_Return
            End

            Move "Do you want to Register this component?\n" to sText
            Move "\n\nNote: When you click the 'Yes' button and UAC - User Access Control - is active on the machine, you will be presented with a Windows dialog with the question: 'Do you want to allow the following program to make changes to this computer?'. Select Yes to make the changes." to sNote
            Get YesNo_Box (sText + sPath + sCOMComponentFileName + sNote) to iRetval
            If (iRetval = MBR_No) Begin
                Procedure_Return
            End

            Get RunRegSvrProgram of ghoManifestFunctionLibrary sPath sCOMComponentFileName True to bOK
        End_Procedure

    End_Object

    Object oUnRegister_btn is a cRDCButton
        Set Label to "Unregister!"
        Set Location to 135 196
        Set Enabled_State to False
        Set psImage to "UnRegisterDLL.ico"
        Set Status_Help to "UnRegister the selected COM (OCX/DLL) component in Windows registry."
        Set peAnchors to anNone
        Set Size to 14 56

        Procedure OnClick
            String sPath sCOMComponentFileName sText sNote
            Boolean bOK bRegistered
            Integer iRetval

            Get Value of oCOMComponentPath_fm to sPath
            Get Value of oCOMComponentFileName_fm to sCOMComponentFileName
            If (sPath = "" or sCOMComponentFileName = "") Begin
                Send Info_Box "You need to select a COM component (.ocx or .dll file) first."
                Procedure_Return
            End
            Get vFolderFormat of ghoManifestFunctionLibrary sPath to sPath

            Get CheckIfCOMComponentIsRegistered of ghoManifestFunctionLibrary sPath sCOMComponentFileName to bRegistered

            If (bRegistered = False) Begin
                Send Info_Box ("The" * sCOMComponentFileName * "component is NOT registered with Windows.")
                Procedure_Return
            End

            Move "Do you want to UnRegister this component?\n" to sText
            Move "\n\nNote: When you click the 'Yes' button and UAC - User Access Control - is active on the machine, you will be presented with a Windows dialog with the question: 'Do you want to allow the following program to make changes to this computer?'. Select Yes to make the changes." to sNote
            Get YesNo_Box (sText + sPath + sCOMComponentFileName + sNote) to iRetval
            If (iRetval = MBR_No) Begin
                Procedure_Return
            End

            Get RunRegSvrProgram of ghoManifestFunctionLibrary sPath sCOMComponentFileName False to bOK
        End_Procedure

    End_Object

    Object oInfo_3d is a Container3d
        Set Size to 43 459
        Set Location to 7 10
        Set peAnchors to anTopLeftRight
        Set Color to clWhite
        Set Border_Style to Border_Normal
        Set Skip_State to True

        Object oInfo_tb is a cTextEdit
            Set Size to 34 443
            Set Location to 4 7
            Set peAnchors to anTopLeftRight
            Set Border_Style to Border_None
            Set Skip_State to True
            Set Read_Only_State to True
            Procedure OnStartup
                String sValue
                Move "If you can't find a manifest fragment file for a COM component (OCX/DLL file) in the local Manifest Fragment Library," to sValue
                Move (sValue * "nor in the global library on GitHub (use 'Get new files from GitHub...' in the Fragments menu to check) - you can create one here.") to sValue
                Move (sValue * "The component must be registered with Windows. If it is not and you press the 'Create!' button, you will get a question if you would like to register it.") to sValue
                Move (sValue * "It is important to understand that this process is by no means foolproof. It is your responsibility to check that the new file works properly.") to sValue
                Move (sValue * "When you have verified that it works properly, use 'Share your files on GitHub...' in the Fragments menu so that the new manifest fragment file can be uploaded to the global library on GitHub, to be used by all other users of this tool.") to sValue
                Move (sValue * "To create fragment files for all the COM components in a folder in one go - for example a new CodeJock release - press the 'Folder...' button.") to sValue
                Set Value to sValue
            End_Procedure
            Send OnStartup
        End_Object

    End_Object

    Procedure End_Construct_Object
        Forward Send End_Construct_Object
        Set piMaxSize to (Hi(Size(Self))) (Low(Size(Self) + 300))
    End_Procedure

    On_Key Key_Alt+Key_C  Send KeyAction of oCreate_btn
    On_Key Key_Ctrl+Key_C Send KeyAction of oCreate_btn
    On_Key kCancel        Send KeyAction of oCancel_Btn
End_Object
