// oManifestFunctionLibrary-Tests.pkg - the functions of cManifestFunctionLibrary that need no database,
// no window and no COM component installed: git's name for a file's content, the platform a program
// file is built for, and the small text helpers.
//
// The package creates its own object (ghoManifestFunctionLibrary). Its start-up reads the program's ini
// file only; it writes nothing.

Use DFUnit\Fixturing\Fixture.pkg
Use cManifestFunctionLibrary.pkg

Object oManifestFunctionLibrary_Tests is a cTestFixture
    Set psTestFixtureName to "cManifestFunctionLibrary"

    // ---------------------------------------------------------------- GitBlobSha

    // git hash-object of an empty file.
    { Published=True }
    Procedure Test_GitBlobSha_Of_Empty_Content
        String sSha

        Get GitBlobSha of ghoManifestFunctionLibrary "" to sSha
        Send AssertSAreEqual "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391" sSha "git's name for an empty file."
    End_Procedure

    // git hash-object of "hello" and a line feed. The first byte of the hash is 206 (hex ce): a UChar of 128
    // or more reads as negative in an expression, and before the fix the name began "e" instead of "ce".
    { Published=True }
    Procedure Test_GitBlobSha_Of_Hello_Starts_With_A_High_Byte
        String sSha

        Get GitBlobSha of ghoManifestFunctionLibrary ("hello" + Character(10)) to sSha
        Send AssertSAreEqual "ce013625030ba8dba906f756967f9e9ca394464a" sSha "git's name for hello + LF."
        Send AssertIAreEqual 40 (Length(sSha)) "Always 40 hex digits."
    End_Procedure

    // ---------------------------------------------------------------- ByteValue / ComponentPlatform

    { Published=True }
    Procedure Test_ByteValue_Reads_A_High_Byte_As_Positive
        UChar[] ucData
        Integer iByte

        Move 206 to ucData[0]
        Move 77  to ucData[1]
        Get ByteValue of ghoManifestFunctionLibrary ucData 0 to iByte
        Send AssertIAreEqual 206 iByte "206 stays 206."
        Get ByteValue of ghoManifestFunctionLibrary ucData 1 to iByte
        Send AssertIAreEqual 77 iByte "A low byte is unchanged."
    End_Procedure

    // This test program is itself a Windows program file, so its PE header names the platform it was built for.
    { Published=True }
    Procedure Test_ComponentPlatform_Of_This_Program
        String sFileName sPlatform sExpected

        Get GetApplicationFileName of ghoApplication to sFileName
        Get ComponentPlatform of ghoManifestFunctionLibrary sFileName to sPlatform
#IFDEF IS$WIN64
        Move "x64" to sExpected
#ELSE
        Move "x86" to sExpected
#ENDIF
        Send AssertSAreEqual sExpected sPlatform ("The platform of " + sFileName)
    End_Procedure

    { Published=True }
    Procedure Test_ComponentPlatform_Of_A_Missing_File_Is_Empty
        String sPlatform

        Get ComponentPlatform of ghoManifestFunctionLibrary "C:\No Such Folder 7Q\NoSuchFile.ocx" to sPlatform
        Send AssertSAreEqual "" sPlatform "No file, no platform."
    End_Procedure

    // Config.ws sits beside every DataFlex program: a text file, not a program file.
    { Published=True }
    Procedure Test_ComponentPlatform_Of_A_Text_File_Is_Empty
        String sFileName sPlatform

        Get psProgramPath of (phoWorkspace(ghoApplication)) to sFileName
        Move (vFolderFormat(sFileName) + "Config.ws") to sFileName
        Get ComponentPlatform of ghoManifestFunctionLibrary sFileName to sPlatform
        Send AssertSAreEqual "" sPlatform ("Not a program file: " + sFileName)
    End_Procedure

    // ---------------------------------------------------------------- ExtractCLSIDFromDump

    { Published=True }
    Procedure Test_ExtractCLSIDFromDump_Keeps_The_Braces
        String sCLSID

        Get ExtractCLSIDFromDump of ghoManifestFunctionLibrary "  CLSID: {A1B2C3D4-0000-1111-2222-333344445555}  " to sCLSID
        Send AssertSAreEqual "{A1B2C3D4-0000-1111-2222-333344445555}" sCLSID "The CLSID with its braces."
    End_Procedure

    { Published=True }
    Procedure Test_ExtractCLSIDFromDump_Without_Braces_Is_Empty
        String sCLSID

        Get ExtractCLSIDFromDump of ghoManifestFunctionLibrary "no class id on this line" to sCLSID
        Send AssertSAreEqual "" sCLSID "No braces, no CLSID."
    End_Procedure

    // ---------------------------------------------------------------- CompareTypeLibIDs

    // Two fragment files name the same type library when their tlbid matches - whatever the case, and
    // whatever follows it on the line.
    { Published=True }
    Procedure Test_CompareTypeLibIDs_Ignores_Case_And_The_Rest_Of_The_Line
        tFileStruct TypeLib1 TypeLib2
        Integer iResult

        Move '<typelib tlbid="{AAAA0000-1111-2222-3333-444455556666}" version="1.0" />' to TypeLib1.sFileNameSecondCol
        Move '<typelib tlbid="{aaaa0000-1111-2222-3333-444455556666}" version="2.4" helpdir="" />' to TypeLib2.sFileNameSecondCol
        Get CompareTypeLibIDs of ghoManifestFunctionLibrary TypeLib1 TypeLib2 to iResult
        Send AssertIAreEqual (EQ) iResult "The same type library."
    End_Procedure

    { Published=True }
    Procedure Test_CompareTypeLibIDs_Orders_Different_IDs
        tFileStruct TypeLib1 TypeLib2
        Integer iResult

        Move '<typelib tlbid="{AAAA0000-1111-2222-3333-444455556666}" version="1.0" />' to TypeLib1.sFileNameSecondCol
        Move '<typelib tlbid="{BBBB0000-1111-2222-3333-444455556666}" version="1.0" />' to TypeLib2.sFileNameSecondCol
        Get CompareTypeLibIDs of ghoManifestFunctionLibrary TypeLib1 TypeLib2 to iResult
        Send AssertIAreEqual (LT) iResult "A before B."
        Get CompareTypeLibIDs of ghoManifestFunctionLibrary TypeLib2 TypeLib1 to iResult
        Send AssertIAreEqual (GT) iResult "B after A."
    End_Procedure

    // ---------------------------------------------------------------- IsNumeric / InsertThousandsSeparators

    { Published=True }
    Procedure Test_IsNumeric
        Send Assert      (IsNumeric("12345"))  "Digits."
        Send Assert      (IsNumeric(" -42 "))  "A minus sign, with spaces round it."
        Send AssertFalse (IsNumeric("12a"))    "A letter."
        Send AssertFalse (IsNumeric("1.5"))    "A decimal separator is not a digit."
        Send AssertFalse (IsNumeric(""))       "Empty."
    End_Procedure

    // The thousands separator is the one the decimal separator leaves free: "," when the decimal separator
    // is ".", and "." when it is ",".
    { Published=True }
    Procedure Test_InsertThousandsSeparators
        Integer iSeparator
        String sDec sTh sResult

        Get_Attribute DF_DECIMAL_SEPARATOR to iSeparator
        Move (Character(iSeparator)) to sDec
        If (sDec = ",") Begin
            Move "." to sTh
        End
        Else Begin
            Move "," to sTh
        End

        Get InsertThousandsSeparators of ghoManifestFunctionLibrary "1234567" to sResult
        Send AssertSAreEqual ("1" + sTh + "234" + sTh + "567") sResult "Seven digits."
        Get InsertThousandsSeparators of ghoManifestFunctionLibrary "999" to sResult
        Send AssertSAreEqual "999" sResult "Three digits need no separator."
        Get InsertThousandsSeparators of ghoManifestFunctionLibrary ("-1234567" + sDec + "89") to sResult
        Send AssertSAreEqual ("-1" + sTh + "234" + sTh + "567" + sDec + "89") sResult "Negative, with decimals."
    End_Procedure

    // ---------------------------------------------------------------- Compile the program: what CompileProgram finds

    // A scratch workspace folder under the user's temp folder: <temp>\CMSCompileTest\ with AppSrc\Prog.src.
    Function ScratchWorkspaceFolder Returns String
        String sFolder
        Integer iVoid
        Get vGetTempPath to sFolder
        Move (vFolderFormat(sFolder) + "CMSCompileTest\") to sFolder
        Send RemoveScratchWorkspace sFolder
        Move (vCreateDirectory(sFolder)) to iVoid
        Move (vCreateDirectory(sFolder + "AppSrc")) to iVoid
        Send WriteScratchFile (sFolder + "AppSrc\Prog.src") "// a scratch program"
        Function_Return sFolder
    End_Function

    // A file with one line of text.
    Procedure WriteScratchFile String sFile String sText
        Integer iCh
        Get Seq_Open_Output_Channel sFile to iCh
        If (iCh > DF_SEQ_CHANNEL_ERROR) Begin
            Writeln channel iCh sText
            Send Seq_Close_Channel iCh
        End
    End_Procedure

    // The scratch folder emptied and removed: its .sws files, the source and the two folders.
    Procedure RemoveScratchWorkspace String sFolder
        Integer iVoid
        Move (vDeleteFile(sFolder + "Listed.sws")) to iVoid
        Move (vDeleteFile(sFolder + "Other.sws")) to iVoid
        Move (vDeleteFile(sFolder + "Old.sws")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Prog.src")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Prog.cfg")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Tool.src")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Tool.cfg")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Grid.txt")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Grid.x64.txt")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Skin.txt")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Prog.exe.manifest")) to iVoid
        Move (vDeleteFile(sFolder + "AppSrc\Packed.exe")) to iVoid
        Move (vRemoveDirectory(sFolder + "AppSrc")) to iVoid
        Move (vRemoveDirectory(sFolder)) to iVoid
    End_Procedure

    { Published=True }
    Procedure Test_ManifestProgramName
        String sSaved sName
        Get psManifestFileName of ghoManifestFunctionLibrary to sSaved
        Set psManifestFileName of ghoManifestFunctionLibrary to "RDCToolsLaptopAlarm.exe.manifest"
        Get ManifestProgramName of ghoManifestFunctionLibrary to sName
        Send AssertSAreEqual "RDCToolsLaptopAlarm" sName ".exe.manifest goes."
        Set psManifestFileName of ghoManifestFunctionLibrary to "Order.MANIFEST"
        Get ManifestProgramName of ghoManifestFunctionLibrary to sName
        Send AssertSAreEqual "Order" sName "Any case."
        Set psManifestFileName of ghoManifestFunctionLibrary to sSaved
    End_Procedure

    // Versions stay text: "19.1" read as a Number would follow the locale's decimal separator.
    { Published=True }
    Procedure Test_DataFlex_Versions
        Send AssertSAreEqual "26.0" (NormalizedDataFlexVersion(ghoManifestFunctionLibrary, "26")) "26 is 26.0."
        Send AssertSAreEqual "26.0" (NormalizedDataFlexVersion(ghoManifestFunctionLibrary, ' "26.0" ')) "Quotes and spaces go."
        Send AssertSAreEqual "" (NormalizedDataFlexVersion(ghoManifestFunctionLibrary, "")) "No version."
        Send AssertIAreEqual 19 (DataFlexVersionPart(ghoManifestFunctionLibrary, "19.1", 0)) "The major part."
        Send AssertIAreEqual 1  (DataFlexVersionPart(ghoManifestFunctionLibrary, "19.1", 1)) "The minor part."
        Send AssertIAreEqual -1 (CompareDataFlexVersions(ghoManifestFunctionLibrary, "19.1", "26.0")) "19.1 is before 26.0."
        Send AssertIAreEqual 1  (CompareDataFlexVersions(ghoManifestFunctionLibrary, "25.0", "20.1")) "25.0 is after 20.1."
        Send AssertIAreEqual 0  (CompareDataFlexVersions(ghoManifestFunctionLibrary, "25.0", "25.0")) "The same."
        Send AssertIAreEqual 1  (CompareDataFlexVersions(ghoManifestFunctionLibrary, "19.10", "19.2")) "10 is after 2."
    End_Procedure

    // An INI .sws (DataFlex 25 and before): Version= under [Properties], the program under [Projects].
    { Published=True }
    Procedure Test_WorkspaceFileVersion_Ini
        String sFolder sVersion sSws
        Boolean bListed
        Integer iCh
        Get ScratchWorkspaceFolder to sFolder
        Move (sFolder + "Old.sws") to sSws
        Get Seq_Open_Output_Channel sSws to iCh
        Writeln channel iCh "[Properties]"
        Writeln channel iCh "Version=19.1"
        Writeln channel iCh "[WorkspacePaths]"
        Writeln channel iCh "ConfigFile=.\Programs\Config.ws"
        Writeln channel iCh "[Projects]"
        Writeln channel iCh "Project0=Other.src"
        Writeln channel iCh "Project1=Prog.src"
        Send Seq_Close_Channel iCh
        Get WorkspaceFileVersion of ghoManifestFunctionLibrary sSws "Prog.src" (&bListed) to sVersion
        Send AssertSAreEqual "19.1" sVersion "Version= under [Properties]."
        Send Assert bListed "Prog.src is under [Projects]."
        Get WorkspaceFileVersion of ghoManifestFunctionLibrary sSws "Missing.src" (&bListed) to sVersion
        Send AssertFalse bListed "Missing.src is not."
        Send RemoveScratchWorkspace sFolder
    End_Procedure

    // A JSON .sws (DataFlex 26 on): "df", and the program in "projects".
    { Published=True }
    Procedure Test_WorkspaceFileVersion_Json
        String sFolder sVersion sSws
        Boolean bListed
        Integer iCh
        Get ScratchWorkspaceFolder to sFolder
        Move (sFolder + "Listed.sws") to sSws
        Get Seq_Open_Output_Channel sSws to iCh
        Writeln channel iCh "{"
        Writeln channel iCh '    "df": 26.0,'
        Writeln channel iCh '    "projects": ['
        Writeln channel iCh '        "Prog.src"'
        Writeln channel iCh "    ],"
        Writeln channel iCh '    "workspaceName": "Scratch"'
        Writeln channel iCh "}"
        Send Seq_Close_Channel iCh
        Get WorkspaceFileVersion of ghoManifestFunctionLibrary sSws "prog.SRC" (&bListed) to sVersion
        Send AssertSAreEqual "26.0" sVersion '"df".'
        Send Assert bListed "Prog.src is in projects, in any case."
        Send RemoveScratchWorkspace sFolder
    End_Procedure

    // This test program is built by DataFlex 26, so 26.0 is installed: the registry's 64-bit view names its
    // folder - this program is 32-bit - and its compiler is df-cli.
    { Published=True }
    Procedure Test_DataFlexRootFolder_And_Compiler_Of_26
        String sRoot sCompiler
        Boolean bExists
        Get DataFlexRootFolder of ghoManifestFunctionLibrary "26.0" to sRoot
        Send Assert (sRoot <> "") "DataFlex 26.0 is installed."
        Send AssertSAreEqual "\" (Right(sRoot, 1)) "The folder ends with a backslash."
        Get DataFlexCompiler of ghoManifestFunctionLibrary sRoot "26.0" "C:\X\AppSrc\X.src" to sCompiler
        Send AssertSAreEqual "df-cli.exe" (Lowercase(Right(sCompiler, 10))) "26 compiles with df-cli."
        Get vFilePathExists sCompiler to bExists
        Send Assert bExists ("The compiler is there:" * sCompiler)
        Get DataFlexRootFolder of ghoManifestFunctionLibrary "9.9" to sRoot
        Send AssertSAreEqual "" sRoot "No DataFlex 9.9."
    End_Procedure

    // The workspace that lists the program wins over one that does not; with none listing it, any is taken; a
    // version that is not installed is no use, and the reason says so.
    { Published=True }
    Procedure Test_ProgramWorkspace
        String sFolder sSrc sSws sVersion sRoot sWhy
        Integer iCh
        Get ScratchWorkspaceFolder to sFolder
        Move (sFolder + "AppSrc\Prog.src") to sSrc

        Get Seq_Open_Output_Channel (sFolder + "Other.sws") to iCh
        Writeln channel iCh '{ "df": 26.0, "projects": [ "Another.src" ] }'
        Send Seq_Close_Channel iCh
        Get ProgramWorkspace of ghoManifestFunctionLibrary sSrc (&sVersion) (&sRoot) (&sWhy) to sSws
        Send AssertSAreEqual (sFolder + "Other.sws") sSws "None lists it: the one there is."
        Send AssertSAreEqual "26.0" sVersion "Its version."

        Get Seq_Open_Output_Channel (sFolder + "Listed.sws") to iCh
        Writeln channel iCh "{"
        Writeln channel iCh '    "df": 26.0,'
        Writeln channel iCh '    "projects": [ "Prog.src" ]'
        Writeln channel iCh "}"
        Send Seq_Close_Channel iCh
        Get ProgramWorkspace of ghoManifestFunctionLibrary sSrc (&sVersion) (&sRoot) (&sWhy) to sSws
        Send AssertSAreEqual (sFolder + "Listed.sws") sSws "The one that lists it."

        Send RemoveScratchWorkspace sFolder
        Get ScratchWorkspaceFolder to sFolder
        Get Seq_Open_Output_Channel (sFolder + "Old.sws") to iCh
        Writeln channel iCh "[Properties]"
        Writeln channel iCh "Version=9.9"
        Writeln channel iCh "[Projects]"
        Writeln channel iCh "Project0=Prog.src"
        Send Seq_Close_Channel iCh
        Get ProgramWorkspace of ghoManifestFunctionLibrary sSrc (&sVersion) (&sRoot) (&sWhy) to sSws
        Send AssertSAreEqual "" sSws "DataFlex 9.9 is not installed."
        Send Assert (Pos("9.9", sWhy) > 0) ("The reason names the version:" * sWhy)
        Send RemoveScratchWorkspace sFolder
    End_Procedure

    // The compiler adds the .cfg's build suffix to the program file: CMBuilder64.exe is CMBuilder.src's (Nils
    // 2026-11-19: "There is no xx64.src on disk").
    { Published=True }
    Procedure Test_ProgramSourceFile_Of_A_Suffixed_Build
        String sFolder sSavedName sSavedPath sSrc
        Get ScratchWorkspaceFolder to sFolder
        Send WriteScratchFile (sFolder + "AppSrc\Prog.cfg") "[Compiler]"
        Send WriteScratchFile (sFolder + "AppSrc\Tool.src") "// a scratch program"
        Send WriteScratchFile (sFolder + "AppSrc\Tool.cfg") "64BitSuffix=_x64"
        Get psManifestFileName of ghoManifestFunctionLibrary to sSavedName
        Get psTargetPath of ghoManifestFunctionLibrary to sSavedPath
        Set psTargetPath of ghoManifestFunctionLibrary to (sFolder + "AppSrc\")

        Set psManifestFileName of ghoManifestFunctionLibrary to "Prog.exe.manifest"
        Get ProgramSourceFile of ghoManifestFunctionLibrary to sSrc
        Send AssertSAreEqual (sFolder + "AppSrc\Prog.src") sSrc "The program's own name."
        Set psManifestFileName of ghoManifestFunctionLibrary to "Prog64.exe.manifest"
        Get ProgramSourceFile of ghoManifestFunctionLibrary to sSrc
        Send AssertSAreEqual (sFolder + "AppSrc\Prog.src") sSrc "64 - the suffix when the .cfg names none."
        Set psManifestFileName of ghoManifestFunctionLibrary to "Tool_x64.exe.manifest"
        Get ProgramSourceFile of ghoManifestFunctionLibrary to sSrc
        Send AssertSAreEqual (sFolder + "AppSrc\Tool.src") sSrc "The suffix the .cfg names."
        Set psManifestFileName of ghoManifestFunctionLibrary to "Tool64.exe.manifest"
        Get ProgramSourceFile of ghoManifestFunctionLibrary to sSrc
        Send AssertSAreEqual "" sSrc "64 is not Tool's suffix."
        Set psManifestFileName of ghoManifestFunctionLibrary to "Other64.exe.manifest"
        Get ProgramSourceFile of ghoManifestFunctionLibrary to sSrc
        Send AssertSAreEqual "" sSrc "No such source."

        Set psManifestFileName of ghoManifestFunctionLibrary to sSavedName
        Set psTargetPath of ghoManifestFunctionLibrary to sSavedPath
        Send RemoveScratchWorkspace sFolder
    End_Procedure

    // Two fragment files that declare the same COM class - the 32-bit and the 64-bit file of one component - are named,
    // as a manifest may declare a class only once (Nils 2026-11-19: mt.exe exit code 31). Case does not matter.
    { Published=True }
    Procedure Test_FragmentFilesSharingClasses
        String sFolder sReport
        String[] asFiles asNone
        Get ScratchWorkspaceFolder to sFolder
        Send WriteScratchFile (sFolder + "AppSrc\Grid.txt")     '<comClass clsid="{c0de2430-17a6-427a-972a-53bae2d968c7}" description="Codejock.GridRecord.24.3.0"></comClass>'
        Send WriteScratchFile (sFolder + "AppSrc\Grid.x64.txt") '<comClass clsid="{C0DE2430-17A6-427A-972A-53BAE2D968C7}" description="Codejock.GridRecord.24.3.0"></comClass>'
        Send WriteScratchFile (sFolder + "AppSrc\Skin.txt")     '<comClass clsid="{c0de2430-2217-42ee-b1b0-82c890431f17}" description="Xtreme SkinFramework Control"></comClass>'

        Move "Grid.txt"     to asFiles[0]
        Move "Grid.x64.txt" to asFiles[1]
        Move "Skin.txt"     to asFiles[2]
        Get FragmentFilesSharingClasses of ghoManifestFunctionLibrary (sFolder + "AppSrc") (&asFiles) to sReport
        Send Assert (sReport contains "Grid.txt and Grid.x64.txt") ("Both files named: " + sReport)
        Send Assert (sReport contains "{C0DE2430-17A6-427A-972A-53BAE2D968C7}") ("The class named: " + sReport)
        Send AssertFalse (sReport contains "Skin.txt") "A file with classes of its own is not named."

        Move asNone to asFiles
        Move "Grid.x64.txt" to asFiles[0]
        Move "Skin.txt"     to asFiles[1]
        Get FragmentFilesSharingClasses of ghoManifestFunctionLibrary (sFolder + "AppSrc") (&asFiles) to sReport
        Send AssertSAreEqual "" sReport "No class declared twice."

        Move asNone to asFiles
        Move "Grid.txt"    to asFiles[0]
        Move "Missing.txt" to asFiles[1]
        Get FragmentFilesSharingClasses of ghoManifestFunctionLibrary (sFolder + "AppSrc") (&asFiles) to sReport
        Send AssertSAreEqual "" sReport "A missing file is no clash."
        Send RemoveScratchWorkspace sFolder
    End_Procedure

    // What a program has embedded, beside its manifest file (Nils 2026-11-19): none, a manifest without COM files
    // (DataFlex's basic one), the same COM files - written another way, as the Embed writes them - or other ones.
    { Published=True }
    Procedure Test_EmbeddedManifestCompare
        String sFolder sManifest sHead sTail
        Integer eState
        Get ScratchWorkspaceFolder to sFolder
        Move (sFolder + "AppSrc\Prog.exe.manifest") to sManifest
        Move '<?xml version="1.0"?><assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">' to sHead
        Move '</assembly>' to sTail
        Send WriteScratchFile sManifest (sHead + '<file name="Grid.ocx"><comClass clsid="{C0DE2430-0001-0000-0000-000000000001}"></comClass><comClass clsid="{c0de2430-0002-0000-0000-000000000002}"></comClass></file>' + sTail)

        Get EmbeddedManifestCompare of ghoManifestFunctionLibrary "" sManifest to eState
        Send AssertIAreEqual CI_EmbedNone eState "Nothing embedded."
        Get EmbeddedManifestCompare of ghoManifestFunctionLibrary (sHead + '<description>Basic</description>' + sTail) sManifest to eState
        Send AssertIAreEqual CI_EmbedBasic eState "A manifest without COM files."
        Get EmbeddedManifestCompare of ghoManifestFunctionLibrary (sHead + '<file name="GRID.ocx">' + Character(13) + Character(10) + '<comClass clsid="{c0de2430-0002-0000-0000-000000000002}" />' + '<comClass clsid="{c0de2430-0001-0000-0000-000000000001}" />' + '</file>' + sTail) sManifest to eState
        Send AssertIAreEqual CI_EmbedSame eState "The same file and classes, written another way."
        Get EmbeddedManifestCompare of ghoManifestFunctionLibrary (sHead + '<file name="Grid.ocx"><comClass clsid="{c0de2430-0001-0000-0000-000000000001}"></comClass></file>' + sTail) sManifest to eState
        Send AssertIAreEqual CI_EmbedDiffers eState "A class less."
        Get EmbeddedManifestCompare of ghoManifestFunctionLibrary (sHead + '<file name="Other.ocx"><comClass clsid="{C0DE2430-0001-0000-0000-000000000001}"></comClass><comClass clsid="{c0de2430-0002-0000-0000-000000000002}"></comClass></file>' + sTail) sManifest to eState
        Send AssertIAreEqual CI_EmbedDiffers eState "Another file."
        Send RemoveScratchWorkspace sFolder
    End_Procedure

    // A program compressed by UPX names its UPX0 section near the start; a file that is not a program has no
    // embedded manifest.
    { Published=True }
    Procedure Test_IsUPXCompressed_And_No_Program
        String sFolder sText
        Boolean bPacked
        Get ScratchWorkspaceFolder to sFolder
        Send WriteScratchFile (sFolder + "AppSrc\Packed.exe") "MZ - .text UPX0 UPX1 .rsrc"
        Get IsUPXCompressed of ghoManifestFunctionLibrary (sFolder + "AppSrc\Packed.exe") to bPacked
        Send Assert bPacked "UPX0 in the header."
        Get IsUPXCompressed of ghoManifestFunctionLibrary (sFolder + "AppSrc\Prog.src") to bPacked
        Send AssertFalse bPacked "No UPX0."
        Get IsUPXCompressed of ghoManifestFunctionLibrary (sFolder + "AppSrc\Missing.exe") to bPacked
        Send AssertFalse bPacked "No file."
        Get EmbeddedManifestText of ghoManifestFunctionLibrary (sFolder + "AppSrc\Prog.src") to sText
        Send AssertSAreEqual "" sText "Not a program: nothing embedded."
        Send RemoveScratchWorkspace sFolder
    End_Procedure

    // ---------------------------------------------------------------- x64 manifests (2026-11-20)

    // A program not compiled yet is told by its DataFlex 64BitSuffix; an x64 program gets "amd64".
    { Published=True }
    Procedure Test_ProgramPlatform_And_ManifestArchitecture
        String sPlatform sArchitecture

        Get ProgramPlatform of ghoManifestFunctionLibrary "C:\No Such Folder 7Q\Order64.exe" to sPlatform
        Send AssertSAreEqual "x64" sPlatform "A missing program named ...64.exe is x64."
        Get ProgramPlatform of ghoManifestFunctionLibrary "C:\No Such Folder 7Q\Order.exe" to sPlatform
        Send AssertSAreEqual "" sPlatform "A missing program without the suffix cannot be told."
        Get ManifestArchitecture of ghoManifestFunctionLibrary "x64" to sArchitecture
        Send AssertSAreEqual "amd64" sArchitecture "x64 is amd64 in a manifest."
        Get ManifestArchitecture of ghoManifestFunctionLibrary "ARM64" to sArchitecture
        Send AssertSAreEqual "arm64" sArchitecture "ARM64."
        Get ManifestArchitecture of ghoManifestFunctionLibrary "x86" to sArchitecture
        Send AssertSAreEqual "X86" sArchitecture "x86."
        Get ManifestArchitecture of ghoManifestFunctionLibrary "" to sArchitecture
        Send AssertSAreEqual "X86" sArchitecture "Not known: X86, as before."
    End_Procedure

    { Published=True }
    Procedure Test_LineWithArchitecture
        String sLine

        Get LineWithArchitecture of ghoManifestFunctionLibrary '  version="6.0.0.0" processorArchitecture="X86" publicKeyToken="1"' "amd64" to sLine
        Send AssertSAreEqual '  version="6.0.0.0" processorArchitecture="amd64" publicKeyToken="1"' sLine "The value is replaced, the rest kept."
        Get LineWithArchitecture of ghoManifestFunctionLibrary '<assemblyIdentity PROCESSORARCHITECTURE="x86"/>' "X86" to sLine
        Send AssertSAreEqual '<assemblyIdentity PROCESSORARCHITECTURE="x86"/>' sLine "The same value in another case is left."
        Get LineWithArchitecture of ghoManifestFunctionLibrary '  name="Microsoft.Windows.Common-Controls"' "amd64" to sLine
        Send AssertSAreEqual '  name="Microsoft.Windows.Common-Controls"' sLine "No attribute: unchanged."
        Get LineWithArchitecture of ghoManifestFunctionLibrary 'processorArchitecture="X86"' "" to sLine
        Send AssertSAreEqual 'processorArchitecture="X86"' sLine "No architecture to set: unchanged."
    End_Procedure

    // The hard-coded template: the architecture in both places, the description, and the DPI block inside <assembly>.
    { Published=True }
    Procedure Test_CreateManifestTemplateAsString_For_x64
        String sText
        Integer iDPI iEnd

        Get CreateManifestTemplateAsString of ghoManifestFunctionLibrary True "Order64.exe" "amd64" to sText
        Send AssertIAreEqual 0 (Pos('"X86"', sText)) "No X86 left."
        Send Assert (Pos('<assemblyIdentity version="1.0.0.0"', sText) > 0 and Pos('processorArchitecture="amd64"', sText) > 0) "amd64 is written."
        Send AssertSAreEqual "amd64" (Mid(sText, 5, (Pos('version="6.0.0.0" processorArchitecture="', sText) + 41))) "The Common-Controls dependency is amd64 too."
        Send Assert (Pos("<description>Order64.exe</description>", sText) > 0) "The description is filled in."
        Move (Pos("<dpiAware>", sText)) to iDPI
        Move (Pos("</assembly>", sText)) to iEnd
        Send Assert (iDPI > 0 and iDPI < iEnd) "The DPI block is inside <assembly>."
        Send AssertSAreEqual "</assembly>" (Right(sText, 11)) "</assembly> ends the text."
        Get CreateManifestTemplateAsString of ghoManifestFunctionLibrary False "Order.exe" "" to sText
        Send Assert (Pos('processorArchitecture="X86"', sText) > 0) "No architecture given: X86."
        Send AssertIAreEqual 0 (Pos("dpiAware", sText)) "No DPI block when not asked for."
    End_Procedure

    // An x86 CodeJock fragment for an x64 program is reported; the x64 one and a component that cannot be told are not.
    { Published=True }
    Procedure Test_FragmentPlatformMismatches
        String sFolder sLibrary sReport
        String[] asFiles

        Get ScratchWorkspaceFolder to sFolder
        Get psManifestFragmentLibrary of ghoManifestFunctionLibrary to sLibrary
        Set psManifestFragmentLibrary of ghoManifestFunctionLibrary to (sFolder + "AppSrc")
        Send WriteScratchFile (sFolder + "AppSrc\Grid86.txt") '<file name="Codejock.GridControl.Unicode.v24.3.0.ocx">'
        Send WriteScratchFile (sFolder + "AppSrc\Grid64.txt") '<file name="Codejock.GridControl.Unicode.x64.v24.3.0.ocx">'
        Send WriteScratchFile (sFolder + "AppSrc\Other.txt")  '<file name="Other.ocx">'
        // Not a program file: its platform cannot be read, nor told from its name.
        Send WriteScratchFile (sFolder + "AppSrc\Other.ocx")  "not a program"
        Move "Grid86.txt" to asFiles[0]
        Move "Grid64.txt" to asFiles[1]
        Move "Other.txt"  to asFiles[2]

        Get FragmentPlatformMismatches of ghoManifestFunctionLibrary (sFolder + "AppSrc") "x64" (&asFiles) to sReport
        Send Assert (Pos("Grid86.txt - for x86", sReport) > 0) "The x86 fragment is reported."
        Send AssertIAreEqual 0 (Pos("Grid64.txt", sReport)) "The x64 fragment matches."
        Send AssertIAreEqual 0 (Pos("Other.txt", sReport)) "A component that cannot be told is left out."
        Get FragmentPlatformMismatches of ghoManifestFunctionLibrary (sFolder + "AppSrc") "x86" (&asFiles) to sReport
        Send Assert (Pos("Grid64.txt - for x64", sReport) > 0) "For an x86 program the x64 one is reported."
        Get FragmentPlatformMismatches of ghoManifestFunctionLibrary (sFolder + "AppSrc") "" (&asFiles) to sReport
        Send AssertSAreEqual "" sReport "The program's platform not known: nothing checked."

        Set psManifestFragmentLibrary of ghoManifestFunctionLibrary to sLibrary
        Send RemoveScratchWorkspace sFolder
    End_Procedure

    // ---------------------------------------------------------------- the unattended build (/build, 2026-11-21)

    // Puts the library back as the program has it: nothing unattended, an empty log.
    Procedure Build_Reset
        String[] asNone
        Set pbUnattended     of ghoManifestFunctionLibrary to False
        Set pasUnattendedLog of ghoManifestFunctionLibrary to asNone
    End_Procedure

    // In a build nobody can answer, so the caller's answer is given - and the question and the answer are both in
    // the log, so every choice a build made can be read afterwards.
    { Published=True }
    Procedure Test_Build_AskYesNo_Gives_The_Unattended_Answer_And_Logs_It
        String[] asLog
        Integer iAnswer

        Send Build_Reset
        Set pbUnattended of ghoManifestFunctionLibrary to True
        Get AskYesNo of ghoManifestFunctionLibrary "Embed it?" "" MBR_Yes to iAnswer
        Send AssertIAreEqual MBR_Yes iAnswer "The answer given for a build."
        Get AskYesNo of ghoManifestFunctionLibrary "Write it anyway?" "Platform" MBR_No to iAnswer
        Send AssertIAreEqual MBR_No iAnswer "No is given as No."
        Get pasUnattendedLog of ghoManifestFunctionLibrary to asLog
        Send Build_Reset
        Send AssertIAreEqual 4 (SizeOfArray(asLog)) "Two lines per question: the question, then the answer."
        Send AssertSAreEqual "Question: Embed it?" asLog[0] "The question as it was asked."
        Send Assert (Pos("Answered Yes", asLog[1]) > 0) "The answer, in words."
        Send Assert (Pos("Answered No", asLog[3]) > 0) "No, in words."
    End_Procedure

    // A message in a build is a log line, not a box; Info_Box's "\n" line breaks become real ones, indented.
    { Published=True }
    Procedure Test_Build_Inform_Writes_The_Log_Instead_Of_A_Box
        String[] asLog

        Send Build_Reset
        Set pbUnattended of ghoManifestFunctionLibrary to True
        Send Inform of ghoManifestFunctionLibrary "First line\nSecond line"
        Get pasUnattendedLog of ghoManifestFunctionLibrary to asLog
        Send Build_Reset
        Send AssertIAreEqual 1 (SizeOfArray(asLog)) "One message, one entry."
        Send AssertSAreEqual ("Message: First line" + Character(13) + Character(10) + "    Second line") asLog[0] "The line break kept, indented."
    End_Procedure

    // A program that is not there: exit code 2, the build could not start - and it says why, before any table is read.
    { Published=True }
    Procedure Test_Build_Of_A_Missing_Program_Is_Exit_Code_2
        String[] asLog
        Integer iBuildExit

        Send Build_Reset
        Get UnattendedBuild of ghoManifestFunctionLibrary "C:\NoSuchFolder\NoSuchProgram.exe" False False False to iBuildExit
        Get pasUnattendedLog of ghoManifestFunctionLibrary to asLog
        Send Build_Reset
        Send AssertIAreEqual 2 iBuildExit "Could not start."
        Send Assert (Pos("the program file is not there", asLog[SizeOfArray(asLog) - 1]) > 0) "The reason is the last line."
    End_Procedure

    // An antivirus refusal in mt.exe's words gets the advice to compile instead; any other error gets nothing extra.
    { Published=True }
    Procedure Test_Build_Antivirus_Block_Gets_Advice
        String sAdvice
        Get AntivirusBlockAdvice of ghoManifestFunctionLibrary 'mt.exe : general error c101008d: Failed to write the updated manifest to the resource of file "x.exe". Operation did not complete successfully because the file contains a virus or potentially unwanted software.' to sAdvice
        Send Assert (Pos("Compile the program instead", sAdvice) > 0) "Defender's refusal: compile instead."
        Get AntivirusBlockAdvice of ghoManifestFunctionLibrary 'mt.exe : general error c1010070: Failed to load and parse the manifest.' to sAdvice
        Send AssertSAreEqual "" sAdvice "Another error: no antivirus advice."
    End_Procedure

End_Object
